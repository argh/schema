{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.js",
    "src/builtin-schemas/**",
    "src/types.js",
    "src/errors.js",
    "src/helpers/**"
  ],
  "entryPointStrategy": "expand",
  "out": "docs-output",
  "readme": "none",
  "exclude": [
    "**/node_modules/**",
    "**/coverage/**",
    "**/test/**",
    "**/*.test.js",
    "**/.c8/**",
    "**/examples/**",
    "**/scripts/**"
  ],
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeProtected": true,
  "excludeNotDocumented": true,
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "categorizeByGroup": true,
  "sort": ["source-order"],
  "kindSortOrder": [
    "Class",
    "Constructor",
    "Property",
    "Method",
    "Function"
  ],
  "plugin": ["typedoc-plugin-missing-exports"]
}
