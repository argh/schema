{
  "name": "@versionzero/schema",
  "version": "0.2.1-main.46",
  "description": "A composable schema library for Node.js that supports asynchronous processing",
  "main": "./src/index.js",
  "files": [
    "src/**",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./helpers": "./src/helpers/index.js",
    "./errors": "./src/errors.js",
    "./types": "./src/types.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argh/schema.git"
  },
  "keywords": [
    "schema",
    "argh",
    "versionzero",
    "v0"
  ],
  "author": "argh",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "tsc": ">=5.5"
  },
  "scripts": {
    "test": "mocha --timeout 0 --ui bdd --recursive --exit",
    "test:bail": "mocha -b --timeout 0 --ui bdd --recursive --exit",
    "test:coverage": "c8 mocha --timeout 0 --ui bdd --recursive --exit --ignore 'test/99-*.test.js'",
    "docs:api": "typedoc",
    "docs:api:json": "typedoc --json docs-output/api.json",
    "docs:api:contributors": "typedoc --excludeInternal false --excludePrivate false --out docs-output-contributors",
    "docs:api:contributors:json": "typedoc --excludeInternal false --excludePrivate false --json docs-output-contributors/api.json",
    "docs:api:md": "typedoc --options typedoc-md.json",
    "docs:api:md:contributors": "typedoc --options typedoc-md.json --excludeInternal false --excludePrivate false --out docs-output-md-contributors",
    "docs:processors": "node scripts/extract-processor-docs.js",
    "docs:processors:clean": "rm -rf processors-output-md"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.10",
    "c8": "^8.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.5.4",
    "mocha": "^11.7.4",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-plugin-missing-exports": "^4.1.2",
    "typescript": "~5.8"
  }
}
